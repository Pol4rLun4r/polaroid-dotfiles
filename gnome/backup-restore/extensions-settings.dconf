[screenshot]
backend='gnome-screenshot'
click-action='show-menu'
clipboard-action='none'
copy-button-action='set-image-data'
effect-rescale=100

[space-bar/appearance]
active-workspace-border-radius=255
application-styles='.space-bar {\n  -natural-hpadding: 13px;\n}\n\n.space-bar-workspace-label.active {\n  margin: 0 0px;\n  background-color: rgba(255,255,255,0.3);\n  color: rgba(255,255,255,1);\n  border-color: rgba(0,0,0,0);\n  font-weight: 700;\n  border-radius: 255px;\n  border-width: 0px;\n  padding: 3px 8px;\n}\n\n.space-bar-workspace-label.inactive {\n  margin: 0 0px;\n  background-color: rgba(0,0,0,0);\n  color: rgba(255,255,255,1);\n  border-color: rgba(0,0,0,0);\n  font-weight: 700;\n  border-radius: 255px;\n  border-width: 0px;\n  padding: 3px 8px;\n}\n\n.space-bar-workspace-label.inactive.empty {\n  margin: 0 0px;\n  background-color: rgba(0,0,0,0);\n  color: rgba(255,255,255,0.5);\n  border-color: rgba(0,0,0,0);\n  font-weight: 700;\n  border-radius: 255px;\n  border-width: 0px;\n  padding: 3px 8px;\n}'
custom-styles-enabled=false
custom-styles-failed=false
empty-workspace-border-radius=255
inactive-workspace-border-radius=255
workspace-margin=0
workspaces-bar-padding=13

[space-bar/behavior]
always-show-numbers=false
enable-custom-label=false
enable-custom-label-in-menu=false
indicator-style='workspaces-bar'
position='left'
scroll-wheel='panel'
show-empty-workspaces=true
smart-workspace-names=false
toggle-overview=true

[space-bar/state]
version=34

[system-monitor]
show-download=true
show-swap=true
show-upload=true

